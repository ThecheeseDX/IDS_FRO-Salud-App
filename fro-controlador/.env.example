DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=fro_salud_db

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
#Para que el envío de correos funcione en local, cada uno necesita generar su propia contraseña de aplicación de Google:

#1.Entra a myaccount.google.com/apppasswords
#2.Inicia sesión con tu cuenta Gmail
#3.Si te pide activar verificación en dos pasos primero, actívala en myaccount.google.com → Seguridad
#4.En "Nombre de la app" escribe Fro Salud y presiona Crear
#5.Google te muestra una clave de 16 caracteres, cópiala
#6.En tu .env pon tus propios datos:

#envSMTP_USER=tucorreo@gmail.com
#SMTP_PASS=la clave de 16 caracteres
#Cada uno usa su propio correo, no compartan credenciales.
